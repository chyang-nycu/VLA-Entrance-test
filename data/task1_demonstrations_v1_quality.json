    "how_many_of_24_bc_success_episodes_pass_10mm_gate": {
      "value": "18 of 24",
      "detail": "18/24. The 6 BC-pool episodes exceeding 10mm are seed_1000, seed_1003, seed_1006, seed_1007, seed_1009 (train) and seed_3000 (test)."
    },
    "which_splits_contain_the_seven_gt10mm_cases": {
      "value": [
        "diagnostics",
        "test",
        "train"
      ],
      "detail": "7 total offenders across dataset: 5 in train (seed_1000,1003,1006,1007,1009), 1 in test (seed_3000), 1 in diagnostics (seed_9007). Zero in val."
    },
    "does_retreat_divergence_change_cube_placement_or_success": {
      "value": false,
      "detail": "No. All 7 offending episodes first diverge at RETREAT, which in the state machine (...LOWER_TO_TARGET->SETTLE_LOWER->OPEN->VERIFY_RELEASE->RETREAT->VERIFY_TASK_SUCCESS->DONE) occurs strictly AFTER cube release (OPEN/VERIFY_RELEASE). Placement success is determined before RETREAT begins. Cross-check: the 7 offenders' final_xy_target_error_m (1.5-4.2mm) falls inside the same range as the 22 passing episodes' (1.1-4.1mm), confirming placement accuracy is statistically indistinguishable regardless of RETREAT-phase replay divergence. Zero episodes in the full 29-episode dataset show first divergence before release (0 'before_release' rows)."
    },
    "recommended_default_training_mask": {
      "value": "full_episode_high_fidelity for episodes needing whole-trajectory fidelity (e.g. full-episode imitation of the RETREAT motion itself); task_execution_through_release for standard pick-and-place behavior-cloning (default recommendation, since the task's success/placement is fully determined before RETREAT and 100% of episodes are high-fidelity through that point)",
      "detail": "Default recommendation: task_execution_through_release. It retains all 24 BC-pool episodes (vs. 18/24 for full_episode_high_fidelity) with zero loss of placement-relevant fidelity, since no episode's pre-release trajectory exceeds the 10mm target. Use full_episode_high_fidelity only if a downstream policy must also imitate the post-release RETREAT motion with <=10mm fidelity."
    }
  },
